{
  "preset": "evidence-remotion-v1",
  "version": 1,
  "canvas": {"width":1080,"height":1920,"fps":30},
  "dependencies": {"remotion":"4.0.539","@remotion/cli":"4.0.539","react":"19.2.3","react-dom":"19.2.3"},
  "palette": {"teal":"#54E0C6","white":"#F7FAFC","navy":"#0B1627","highlight":"#FFDD70"},
  "spring": {"damping":19,"stiffness":210,"mass":0.65},
  "ease": [0.16,1,0.3,1],
  "entry": {"opacityFrames":[0,5],"opacity":[0.15,1],"translateY":[64,0],"scale":[0.94,1],"rotationFrames":[0,12],"rotationDegrees":[-2,0]},
  "exit": {"lastFrames":6,"opacity":[1,0]},
  "dimmer": {"color":"rgba(5,12,22,.46)","followsEntryOpacity":true},
  "card": {"left":120,"top":190,"width":840,"height":960,"radius":22,"shadow":"0 24px 65px #0008"},
  "kicker": {"left":110,"top":100,"fontSize":44,"fontWeight":700},
  "source": {"left":120,"top":1162,"fontSize":32,"fontWeight":700},
  "underline": {"left":32,"topRelativeToSummary":142,"height":8,"width":700,"frames":[7,17]},
  "summary": {"left":32,"right":32,"fontSize":54,"fontWeight":800,"lineHeight":1.13,"maxLines":2},
  "summaryLabel": {"fontSize":27,"offsetY":-42},
  "note": {"fontSize":34,"lineHeight":1.25,"offsetY":182,"maxLines":2},
  "fonts": {"family":"ReferenceSans","bold":"fonts/reference-bold.ttf","regular":"fonts/reference-regular.ttf"},
  "nativeBackgroundEffect": {"type":"effect","assetId":"builtin:fx-gaussian-blur","propertyOverrides":{"radius":180},"scope":"every overlapping original talking-head clip; exact intersection only"},
  "render": {"codec":"vp9","imageFormat":"png","pixelFormat":"yuva420p","videoBitrate":"5M","concurrency":2,"audio":false},
  "captionProtection": {"doNotRepaginateExistingCards":true,"maxLines":2,"maxWhitespaceWords":8,"referenceFontSize":48,"referenceTop":1414,"referenceHeight":110},
  "variableContent": ["kicker","publisher","source","regions","summary","note","summaryTop","durationInFrames"],
  "invariants": ["Keep screenshot aspect ratio; region scale equals destination width divided by crop width.","Real article title/date/source; editorial summary explicitly labeled.","No new global caption pagination or transcript edits for an evidence-only request.","No project IDs or article assets are built into this preset."]
}
